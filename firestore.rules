rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Mecze — publiczny odczyt, zapis tylko przez Cloud Functions (admin SDK)
    match /matches/{matchId} {
      allow read: if true;
      allow write: if false;
    }

    // Markety meczów — publiczny odczyt
    match /matches/{matchId}/markets/{marketId} {
      allow read: if true;
      allow write: if false;
    }

    // Użytkownicy — tylko swój profil
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Zakłady — odczyt i tworzenie tylko właściciel, brak edycji/usuwania
    match /bets/{betId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.stake > 0
        && request.resource.data.stake <= 10000;
      allow update, delete: if false;
    }
  }
}
